# =============================================================================
# sevo Backend — Environment Variables Template
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in every value marked <CHANGE_ME> before running the server.
# 3. NEVER commit .env — it contains real secrets.
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<CHANGE_ME_USE_A_LONG_RANDOM_STRING>

# Set to 0 (or omit entirely) in production!
DJANGO_DEBUG=0

# Comma-separated list. Add your VPS hostname / domain here. (e.g., sevo.co.in,www.sevo.co.in,vendor.sevo.co.in)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost,sevo.co.in,www.sevo.co.in,vendor.sevo.co.in

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_NAME=calservices_db
DB_USER=calservices_user
DB_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
DB_HOST=127.0.0.1
DB_PORT=5432

# Leave blank or "prefer" for local PostgreSQL.
# Set to "require" for Supabase/RDS: DB_SSLMODE=require
DB_SSLMODE=prefer

# Statement timeout in ms (e.g. 30000 for 30s)
DB_STATEMENT_TIMEOUT=30000

# Seconds to keep DB connections alive (0 = close after each request)
DB_CONN_MAX_AGE=60

# ── Redis (Celery broker + Django Channels) ───────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Tasks run inline (no worker) only when DJANGO_DEBUG=1 / tests. In production the sevo-celery
# worker (deploy.sh) processes them; set CELERY_TASK_ALWAYS_EAGER=True only to force inline mode.
# CELERY_TASK_ALWAYS_EAGER=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<CHANGE_ME_GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET>
REDIRECT_URI=http://localhost:8000/accounts/google/login/callback/

# ── Google Maps Geocoding API ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=<CHANGE_ME_GOOGLE_MAPS_API_KEY>
VITE_GOOGLE_MAPS_API_KEY=<CHANGE_ME_GOOGLE_MAPS_API_KEY>
VITE_GOOGLE_MAPS_KEY=<CHANGE_ME_GOOGLE_MAPS_API_KEY>

# ── Email (SMTP — used for password reset & invitations) ─────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<CHANGE_ME_YOUR_EMAIL@example.com>
EMAIL_HOST_PASSWORD=<CHANGE_ME_APP_PASSWORD_NOT_ACCOUNT_PASSWORD>

# ── Frontend URL (used in reset-password links) ───────────────────────────────
FRONTEND_URL=http://localhost:5173
# For production: FRONTEND_URL=https://sevo.co.in

# ── CORS & CSRF (comma-separated frontend origins) ────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,https://sevo.co.in,https://www.sevo.co.in,https://vendor.sevo.co.in
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:5176,http://127.0.0.1:5176,https://sevo.co.in,https://www.sevo.co.in,https://vendor.sevo.co.in

# ── Workforce Integration (Vendor App Bridge) ─────────────────────────────────
# Local dev: http://localhost:8001/api/workforce | Production: https://vendor.sevo.co.in/api/workforce
WORKFORCE_API_BASE_URL=http://localhost:8001/api/workforce
WORKFORCE_API_KEY=wf_integration_key_default
WORKFORCE_WEBHOOK_SECRET=dev-insecure-workforce-webhook-secret-local-testing-only
# PRODUCTION: WORKFORCE_WEBHOOK_SECRET must be a real random value, identical on the vendor app.
# The two values above are public local-dev placeholders and are refused when DJANGO_DEBUG=0.

# ── Razorpay / RazorpayX ──────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<CHANGE_ME_RAZORPAY_KEY_ID>
RAZORPAY_KEY_SECRET=<CHANGE_ME_RAZORPAY_KEY_SECRET>
RAZORPAYX_KEY_ID=<CHANGE_ME_RAZORPAYX_KEY_ID>
RAZORPAYX_KEY_SECRET=<CHANGE_ME_RAZORPAYX_KEY_SECRET>
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=<CHANGE_ME_RAZORPAYX_WEBHOOK_SECRET>
RAZORPAYX_MOCK_MODE=0

# ── Supabase Storage (Optional) ───────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=admin-media
ENABLE_LOCAL_STORAGE_FALLBACK=1

# ── JWT Lifetimes ─────────────────────────────────────────────────────────────
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7

# ── Cookie security ───────────────────────────────────────────────────────────
# "Lax" for local dev, "Strict" in production (same-origin)
AUTH_COOKIE_SAMESITE=Lax

# ── Throttling ────────────────────────────────────────────────────────────────
THROTTLE_ANON=60/minute
THROTTLE_USER=300/minute
# Behind nginx/a load balancer set this to the number of trusted proxies in front of Django
# (e.g. 1) so anonymous rate limits apply per visitor instead of to the proxy's single IP.
# THROTTLE_NUM_PROXIES=1

# ── Production proxy path ─────────────────────────────────────────────────────
# Set this if Django is served at a subpath, e.g. FORCE_SCRIPT_NAME=/sevo
FORCE_SCRIPT_NAME=