# ─── Supabase PostgreSQL ──────────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres.zmwwazawnszrlbftqthe
DB_PASSWORD=Calservices@123
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432

# Use in-memory channels for local development without Redis
USE_IN_MEMORY_CHANNELS=True

# Remote TLS host (Supabase): set DB_SSLMODE=require
DB_SSLMODE=require

# Statement timeout for Supabase
DB_STATEMENT_TIMEOUT=30000

# Connection max age (60s to reuse persistent connections with direct connection)
DB_CONN_MAX_AGE=60

# ─── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-only-secret-key-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# ─── CORS (Frontend origins) ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Redis (Celery broker + Django Channels) ──────────────────────────────────
# Redis also runs in Docker at localhost:6379
# For shared environments, replace 'localhost' with the host developer's IP address.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379


