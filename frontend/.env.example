# =============================================================================
# CalTrack Frontend Environment Configuration Template
# =============================================================================

# Central API & WS Base URLs (leave commented to use default Vite dev proxy)
# VITE_API_BASE_URL=http://localhost:8000/api
# VITE_WS_BASE_URL=ws://127.0.0.1:8000/ws
# VITE_BACKEND_URL=http://127.0.0.1:8000

# Google OAuth Client ID
# Get yours: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=<CHANGE_ME_GOOGLE_CLIENT_ID>.apps.googleusercontent.com

# Google Maps Geocoding API Key
# Enable "Geocoding API" and "Places API" in Google Cloud Console
VITE_GOOGLE_MAPS_KEY=<CHANGE_ME_GOOGLE_MAPS_KEY>
VITE_GOOGLE_MAPS_API_KEY=<CHANGE_ME_GOOGLE_MAPS_KEY>

# Microsoft OAuth Client ID (Optional)
VITE_MICROSOFT_CLIENT_ID=

# Razorpay Key ID (Client-side)
VITE_RAZORPAY_KEY_ID=rzp_test_TSN5xnzs6tWLKW
VITE_PAYMENTS_ENABLED=true

# Vendor Platform & API URLs
VITE_VENDOR_PLATFORM_URL=http://localhost:5176
VITE_VENDOR_API_URL=http://localhost:8001
VITE_WORKFORCE_API_URL=http://localhost:8001/api/workforce
